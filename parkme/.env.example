# Nombre de la aplicación
APP_NAME="Parkme!"
# Entorno de la aplicación (local, production, etc)
APP_ENV=local
# Clave de encriptación de la aplicación (generada automáticamente)
APP_KEY=
# Habilitar el modo de depuración (true para desarrollo)
APP_DEBUG=true
# URL base de la aplicación
APP_URL=http://localhost:8000

# Idioma de la aplicación
APP_LOCALE=es
# Idioma de respaldo
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# Rondas de encriptación para contraseñas
BCRYPT_ROUNDS=12

# Configuración de logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Configuración de Base de Datos
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parkme
DB_USERNAME=tu_usuario # (placeholder)
DB_PASSWORD=tu_password # (placeholder)

# Configuración de Sesión
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Otras configuraciones de sistema (Caché, Redis, etc)
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configuración de Correo (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Encriptación del correo (tls/ssl)
MAIL_ENCRYPTION=tls

# Credenciales de correo (descartadas, se usa SMTP_ un poco más abajo por claridad de dominio del negocio)
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Tu EMAIL de Gmail para el sistema
SMTP_EMAIL=tu_correo@gmail.com # (placeholder - developer will fill this)
# Tu Password de Aplicación generada en Google
SMTP_PASSWORD=tu_password_de_aplicacion # (placeholder - developer will fill this)

# Remitente automático
MAIL_FROM_ADDRESS="${SMTP_EMAIL}"
MAIL_FROM_NAME="Parkme!"

# AWS (no requerido)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
